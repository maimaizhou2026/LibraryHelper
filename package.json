{
  "name": "library-helper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build:api": "esbuild src/server/vercelEntry.ts --bundle --platform=node --target=node20 --format=esm --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=api/index.js",
    "build": "npm run build:api && vite build",
    "preview": "vite preview --host",
    "start": "vite preview --host 0.0.0.0 --port 5173"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "lucide-vue-next": "^0.468.0",
    "pinyin-pro": "^3.26.0",
    "sm-crypto": "^0.3.13",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
